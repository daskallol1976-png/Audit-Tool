rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /venueAudits/{auditId} {
      allow read, write: if true;

      match /devices/{deviceId} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
